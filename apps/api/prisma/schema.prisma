// Estio platform content + CRM. DATABASE_URL from prisma.config.ts (Prisma 7+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Marketing / CMS enums ---

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceCategory {
  WEB_DESIGN_DEVELOPMENT
  CONTENT_CAMPAIGNS
  AI_CREATIVE
  ENTERPRISE_AI
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryType {
  GENERAL
  ENTERPRISE
  CONSULTATION
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum NavigationLocation {
  HEADER
  FOOTER
}

enum SiteLocale {
  en
  ar
}

// --- CRM enums (stable values; UI localizes) ---

/// Primary service line for routing and intake.
enum CrmServiceType {
  WEB
  CONTENT
  CAMPAIGNS
  AI_CREATIVE
  ENTERPRISE_AI
  AUTOMATION
  GENERAL
}

enum CrmLeadSource {
  HOMEPAGE
  CONTACT
  SERVICE_PAGE
  INTAKE
  REFERRAL
  PARTNER
  OTHER
  AI_STUDIO
}

enum CrmPriority {
  LOW
  MEDIUM
  HIGH
  STRATEGIC
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NURTURE
  WON
  LOST
  ON_HOLD
}

enum CrmPipelineStage {
  INBOX
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmBudgetRange {
  UNSPECIFIED
  UNDER_5K
  RANGE_5K_25K
  RANGE_25K_75K
  RANGE_75K_200K
  OVER_200K
}

enum CrmTimeline {
  UNSPECIFIED
  IMMEDIATE
  WEEKS_1_4
  MONTHS_1_3
  MONTHS_3_6
  MONTHS_6_PLUS
}

enum CrmBusinessType {
  UNSPECIFIED
  STARTUP
  SMB
  MID_MARKET
  ENTERPRISE
  NONPROFIT
  AGENCY
  OTHER
}

enum CrmTeamSize {
  UNSPECIFIED
  SOLO
  SIZE_2_10
  SIZE_11_50
  SIZE_51_PLUS
}

enum CrmLostReason {
  UNSPECIFIED
  TIMING
  BUDGET
  COMPETITOR
  NO_FIT
  GHOSTED
  OTHER
}

enum LeadActivityType {
  CREATED
  FIELD_UPDATED
  NOTE_ADDED
  TASK_CREATED
  TASK_COMPLETED
  STAGE_CHANGED
  STATUS_CHANGED
  INTAKE_COMPLETED
  AUTOMATION
  EMAIL
  CALL
  MEETING
  PROPOSAL
}

enum LeadTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum AutomationRunType {
  NEW_LEAD_ACK
  ASSIGNMENT
  FOLLOWUP_DUE
  STALE_LEAD
  PROPOSAL_FOLLOWUP
  LOST_REASON_ENFORCE
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  LINKEDIN
  OTHER
}

// --- CMS models ---

model Page {
  id              String     @id @default(cuid())
  slug            String
  locale          SiteLocale @default(en)
  title           String
  metaTitle       String?
  metaDescription String?    @db.Text
  status          PageStatus @default(DRAFT)
  sections        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([slug, locale])
  @@index([status, locale])
}

model Service {
  id               String          @id @default(cuid())
  slug             String
  locale           SiteLocale      @default(en)
  title            String
  shortDescription String
  longDescription  String          @db.Text
  category         ServiceCategory
  status           ContentStatus   @default(DRAFT)
  featured         Boolean         @default(false)
  detailBlocks     Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([slug, locale])
  @@index([category, status])
  @@index([featured])
}

/// Sales-centric lead (CRM). Public website and intake write here with enums only.
model Lead {
  id               String           @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  whatsapp         String?
  company          String?
  jobTitle         String?
  country          String?
  city             String?
  serviceType      CrmServiceType   @default(GENERAL)
  subServiceType   String?          @db.VarChar(128)
  businessType     CrmBusinessType  @default(UNSPECIFIED)
  teamSize         CrmTeamSize      @default(UNSPECIFIED)
  budgetRange      CrmBudgetRange   @default(UNSPECIFIED)
  timeline         CrmTimeline      @default(UNSPECIFIED)
  projectScope     String?          @db.Text
  message          String?          @db.Text
  status           CrmLeadStatus    @default(NEW)
  stage            CrmPipelineStage @default(INBOX)
  score            Int              @default(0)
  scoreBreakdown   Json?
  priority         CrmPriority      @default(MEDIUM)
  ownerUserId      String?
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  lostReason       CrmLostReason    @default(UNSPECIFIED)
  wonValue         Decimal?         @db.Decimal(14, 2)
  source           CrmLeadSource
  /// AI Studio funnel: images | video | brand
  studioIntent     String?          @db.VarChar(32)
  offerType        String?          @db.VarChar(256)
  estimatedValue   Decimal?         @db.Decimal(14, 2)
  /// sessionId, device, locale, ctaPosition, analyticsSessionId, pricingHint, etc.
  crmMetadata      Json?
  locale           SiteLocale?
  referrer         String?          @db.Text
  landingPage      String?          @db.Text
  campaignSource   String?          @db.VarChar(128)
  campaignMedium   String?          @db.VarChar(128)
  campaignName     String?          @db.VarChar(256)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  answers      LeadAnswer[]
  notes        LeadNote[]
  activities   LeadActivity[]
  tasks        LeadTask[]
  assignments  LeadAssignment[]
  proposals    ProposalRecord[]
  automations   AutomationRun[]
  intakeSession IntakeSession?

  @@index([status, createdAt])
  @@index([stage, createdAt])
  @@index([source, createdAt])
  @@index([ownerUserId])
  @@index([nextFollowUpAt])
  @@index([email])
}

/// Internal assignee directory for CRM ownership (not auth; admin auth remains JWT).
model CrmUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamMemberships CrmTeamMember[]

  @@index([isActive])
}

model CrmTeam {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   CrmTeamMember[]
}

model CrmTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  team CrmTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user CrmUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model LeadAnswer {
  id          String   @id @default(cuid())
  leadId      String
  questionKey String   @db.VarChar(160)
  /// Normalized answer payload (string, string[], number, bool).
  valueJson   Json
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([questionKey])
}

model LeadNote {
  id           String   @id @default(cuid())
  leadId       String
  body         String   @db.Text
  authorLabel  String?  @db.VarChar(120)
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  type      LeadActivityType
  payload   Json?
  createdAt DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadTask {
  id          String         @id @default(cuid())
  leadId      String
  title       String
  dueAt       DateTime?
  status      LeadTaskStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lead      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  runLinks  AutomationRun[]   @relation("TaskAutomation")

  @@index([leadId, status])
  @@index([dueAt])
}

model LeadAssignment {
  id             String    @id @default(cuid())
  leadId         String
  assigneeUserId String?
  assignedBy     String?
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([assigneeUserId])
}

model AutomationRun {
  id        String              @id @default(cuid())
  leadId    String?
  taskId    String?
  type      AutomationRunType
  status    AutomationRunStatus
  message   String?             @db.Text
  payload   Json?
  createdAt DateTime            @default(now())

  lead Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  task LeadTask? @relation("TaskAutomation", fields: [taskId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

model ProposalRecord {
  id          String          @id @default(cuid())
  leadId      String
  reference   String          @db.VarChar(160)
  valueAmount Decimal?        @db.Decimal(14, 2)
  sentAt      DateTime?
  acceptedAt  DateTime?
  status      String          @default("DRAFT") @db.VarChar(32)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// Singleton-style row (ensure one via service); JSON for rule weights.
model SalesSettings {
  id                      String   @id @default("default")
  isActive                Boolean  @default(true)
  scoringRules            Json?
  automationRules         Json?
  defaultOwnerUserId      String?
  /// Intent → offer label (CRM)
  intentMapping           Json?
  /// Intent → priority (high | medium | low)
  priorityMapping         Json?
  /// Intent → routing key: "owner" | "sales" | CrmUser id
  routingMapping          Json?
  /// Intent → pricing hint string
  pricingHints            Json?
  /// Pipeline stage key: NEW → INBOX, QUALIFIED → DISCOVERY, etc.
  defaultStage            String   @default("NEW") @db.VarChar(64)
  staleLeadDays           Int      @default(14)
  followUpReminderHours   Int      @default(48)
  proposalFollowUpDays    Int      @default(7)
  lostReasonWhenLostRequired Boolean @default(true)
  updatedAt               DateTime @updatedAt
}

model IntakeSession {
  id          String         @id @default(cuid())
  branch      CrmServiceType @default(GENERAL)
  stepKey     String         @default("start") @db.VarChar(120)
  answersJson Json           @default("{}")
  leadId      String?        @unique
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model MessageTemplate {
  id        String          @id @default(cuid())
  name      String
  channel   MessageChannel
  subject   String?         @db.VarChar(500)
  body      String          @db.Text
  locale    SiteLocale?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Inquiry {
  id        String         @id @default(cuid())
  type      InquiryType
  name      String
  email     String
  phone     String?
  company   String?
  message   String         @db.Text
  status    InquiryStatus  @default(NEW)
  createdAt DateTime       @default(now())

  @@index([type, status])
}

model Settings {
  id             String   @id @default(cuid())
  businessName   String
  brandName      String
  website        String?  @db.VarChar(300)
  businessNameAr String?
  brandNameAr    String?
  phone          String?
  email          String?
  /// WhatsApp click-to-chat URL or wa.me link (site contact blocks).
  whatsapp       String?  @db.VarChar(500)
  address        String?
  city           String?
  country        String?
  footerText     String?  @db.Text
  footerTextAr   String?  @db.Text
  socialLinks    Json?
  /// Global CTA labels, nav hints, etc. i18n-ready: { en: { primaryCta: "..." }, ar: { ... } }.
  globalLabels   Json?
  updatedAt      DateTime @updatedAt
}

model NavigationItem {
  id         String             @id @default(cuid())
  label      String
  href       String
  orderIndex Int                @default(0)
  location   NavigationLocation
  locale     SiteLocale         @default(en)
  isActive   Boolean            @default(true)

  @@index([location, locale, orderIndex])
}

model SeoMetadata {
  id           String     @id @default(cuid())
  route        String
  locale       SiteLocale @default(en)
  title        String
  description  String     @db.Text
  ogImage      String?
  canonicalUrl String?

  @@unique([route, locale])
}

model MediaAsset {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  altText      String?
  category     String?
  publicUrl    String?  @db.Text
  uploadedAt   DateTime @default(now())
  placements   MediaPlacement[]

  @@index([category])
}

// --- Studio analytics ---

/// Raw behavioural events from the AI Studio conversion layer.
model StudioEvent {
  id            String   @id @default(cuid())
  sessionId     String   @db.VarChar(64)
  eventType     String   @db.VarChar(40)
  intent        String?  @db.VarChar(16)
  source        String?  @db.VarChar(16)
  quality       Float?
  ctaPosition   String?  @db.VarChar(16)
  clicked       Boolean  @default(false)
  converted     Boolean  @default(false)
  hoverDuration Int?
  exitGoal      String?  @db.Text
  region        String?  @db.VarChar(10)
  device        String?  @db.VarChar(16)
  locale        String?  @db.VarChar(4)
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([eventType, createdAt])
  @@index([intent, eventType, createdAt])
  @@index([intent, clicked])
  @@index([device, region, intent])
}

/// Daily pre-aggregates for Studio analytics (UTC `day`). Built by rollup job from `StudioEvent`.
model StudioAnalyticsRollupDay {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  locale       String   @default("") @db.VarChar(4)
  device       String   @default("") @db.VarChar(16)
  eventType    String   @db.VarChar(40)
  intent       String   @default("") @db.VarChar(16)
  source       String   @default("") @db.VarChar(16)
  eventCount   Int      @default(0)
  clickCount   Int      @default(0)
  sessionCount Int      @default(0)

  @@unique([day, locale, device, eventType, intent, source])
  @@index([day])
}

/// AI Studio ask/response audit trail for the guided assistant funnel.
model AiStudioAskEvent {
  id                 String   @id @default(cuid())
  sessionId          String   @db.VarChar(80)
  page               String   @db.VarChar(64)
  locale             String   @db.VarChar(4)
  userMessage        String   @db.Text
  normalizedIntent   String   @db.VarChar(16)
  recommendedOffer   String?  @db.VarChar(256)
  recommendedCtaLabel String? @db.VarChar(256)
  secondaryCtaLabel  String?  @db.VarChar(256)
  responseText       String   @db.Text
  source             String?  @db.VarChar(64)
  url                String?  @db.Text
  ipHash             String?  @db.VarChar(64)
  tokensUsed         Int?
  outOfScope         Boolean  @default(false)
  rateLimited        Boolean  @default(false)
  disabledFallback   Boolean  @default(false)
  shouldEscalate     Boolean  @default(false)
  primaryCtaClicked  Boolean  @default(false)
  secondaryCtaClicked Boolean @default(false)
  createdAt          DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([normalizedIntent, createdAt])
  @@map("AiStudioAskEvent")
}

/// Where a media asset appears on the marketing site (synced from page sections).
model MediaPlacement {
  id           String     @id @default(cuid())
  mediaAssetId String
  pageSlug     String     @db.VarChar(120)
  locale       SiteLocale
  sectionKey   String     @db.VarChar(160)
  fieldKey     String     @db.VarChar(160)
  createdAt    DateTime   @default(now())
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, pageSlug, locale, sectionKey, fieldKey])
  @@index([mediaAssetId])
  @@index([pageSlug, locale])
}

// --- Async media generation (BullMQ + Prisma) ---

enum MediaGenerationJobStatus {
  queued
  running
  completed
  failed
}

/// Durable media worker job; full `inputPayload` is for the processor only — not returned on status GET.
model MediaGenerationJob {
  id                 String                   @id @default(uuid())
  type               String                   @default("generate_image")
  status             MediaGenerationJobStatus @default(queued)
  /// Worker hostname from MEDIA_WORKER_URL (e.g. host.docker.internal) for future multi-worker routing.
  workerTargetHost   String?
  /// Base URL of the worker that accepted this job (submit + async poll/result). Set when using MEDIA_WORKER_URLS or explicit pinning.
  workerBaseUrl        String?
  inputPayload       Json
  inputMeta          Json
  resultPayload      Json?
  errorPayload       Json?
  errorMessage       String?
  upstreamHttpStatus Int?
  /// Workstation async job id when MEDIA_WORKER_MODE=async; safe for status API.
  workerRemoteJobId  String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status, createdAt])
  @@map("media_generation_jobs")
}

// =============================================================================
// Phase 2 — wallet auth (SIWE), credit packs, on-chain USDC payments, ledger
// =============================================================================
//
// Money/runtime knobs are env-driven; see deploy/PHASE2_DECISIONS.md for the
// list of operator-set values (chain, RPC, receiving address allowlist, …).
//
// Lifecycle:
//   - User signs a SIWE message  -> AuthService consumes a SiweNonce, upserts
//     a User row, returns a JWT keyed by walletAddress.
//   - User picks a CreditPack    -> PaymentsService creates a Payment with a
//     unique amountAtomic (base + nudge) and a TTL.
//   - On-chain watcher sees the matching USDC Transfer to receivingAddress
//     -> writes Payment.txHash + status='confirmed' AND a CreditLedger row
//     with reason='payment_credit' atomically.
//   - User submits a media job   -> MediaJobsService writes a CreditLedger
//     row with reason='job_debit' in the same Prisma transaction as the
//     MediaGenerationJob row insert (idempotent by (refType, refId)).
//   - On terminal failure        -> CreditLedger row with reason='refund'
//     refunds the original debit (also idempotent by refId).

enum PaymentStatus {
  pending
  confirmed
  expired
  failed
}

enum CreditLedgerReason {
  payment_credit
  job_debit
  refund
  manual_adjust
  /// Phase 4: media generation charge (replaces job_debit for new jobs).
  generation_debit
  /// Phase 4: refund when a generation job fails terminally (replaces refund for new jobs).
  generation_refund
  /// Reserved for future reservation-first accounting (not used in Phase 4 debit path).
  generation_reservation
  generation_reservation_release
}

/// End-user identity. The wallet address (lowercased, with 0x prefix) is the
/// stable identifier; the JWT `sub` is `walletAddress`. We never store any
/// PII beyond what the user explicitly provides (none in Phase 2).
model User {
  id             String    @id @default(uuid())
  walletAddress  String    @unique @db.VarChar(64)
  /// Most recent successful SIWE login.
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments       Payment[]
  ledgerEntries  CreditLedger[]

  @@map("users")
}

/// One-shot SIWE nonce. Created when the client requests a login challenge,
/// consumed (`consumedAt`) on successful verification, expires after
/// `PHASE2_SIWE_NONCE_TTL_SECONDS`. Any attempt to verify a consumed or
/// expired nonce is rejected (replay protection).
model SiweNonce {
  id             String    @id @default(uuid())
  nonce          String    @unique @db.VarChar(64)
  /// Optionally bound to a wallet address at issue time (currently unused;
  /// reserved so a future flow can pre-bind nonces to a specific address).
  walletAddress  String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  @@index([expiresAt])
  @@map("siwe_nonces")
}

/// Catalogue of credit packs the user can buy. CMS / admin can toggle
/// `active`; the PaymentsModule refuses to create a payment for an
/// inactive pack or for a `usdcAmount` above `PHASE2_MAX_PACK_USDC`.
model CreditPack {
  id           String    @id @default(uuid())
  /// Stable slug used in the URL and in payment receipts (e.g. "starter").
  code         String    @unique @db.VarChar(40)
  nameEn       String    @db.VarChar(80)
  nameAr       String    @db.VarChar(80)
  /// Price in USDC (6-decimal, stored as Decimal for human readability;
  /// the on-chain comparison uses the atomic value derived from this).
  usdcAmount   Decimal   @db.Decimal(20, 6)
  /// Number of credits granted on confirmed payment.
  credits      Int
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments     Payment[]

  @@map("credit_packs")
}

/// One pending or confirmed on-chain USDC payment. The `expectedAmountAtomic`
/// includes a per-payment nudge (low ~14 bits derived from the row id) so
/// two simultaneously-pending payments for the same pack never share an
/// amount. `paymentRef` is the public id surfaced to the client / receipt.
model Payment {
  id                    String        @id @default(uuid())
  paymentRef            String        @unique @default(uuid()) @db.VarChar(64)
  userId                String
  packId                String
  receivingAddress      String        @db.VarChar(64)
  /// USDC atomic units (BigInt — USDC has 6 decimals; e.g. $5.00 = 5_000_000).
  expectedAmountAtomic  BigInt
  status                PaymentStatus @default(pending)
  txHash                String?       @db.VarChar(80)
  fromAddress           String?       @db.VarChar(64)
  blockNumber           BigInt?
  confirmedAt           DateTime?
  expiresAt             DateTime
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  pack                  CreditPack    @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  /// Watcher matches incoming Transfers by (receivingAddress, amount) within a
  /// recent block range, so this composite index is the hot lookup.
  @@index([receivingAddress, expectedAmountAtomic, status])
  /// Hard guarantee that we never create two simultaneously-pending payments
  /// for the same (address, amount). PaymentsService picks the nudge to keep
  /// this true.
  @@unique([receivingAddress, expectedAmountAtomic, status], map: "payments_addr_amount_status_uniq")
  @@map("payments")
}

/// Append-only credit ledger. Every credit-affecting action is one row; the
/// user's balance is `sum(delta)` over their rows. `(refType, refId)` is the
/// idempotency key — a watcher rerun, retried debit, or duplicate refund are
/// all guaranteed not to double-apply because the unique index rejects the
/// second insert.
model CreditLedger {
  id            String             @id @default(uuid())
  userId        String
  delta         Int
  reason        CreditLedgerReason
  /// Logical type of the consuming row (e.g. "payment", "job", "manual").
  refType       String             @db.VarChar(40)
  /// Primary key of the consuming row (e.g. Payment.id, MediaGenerationJob.id).
  refId         String             @db.VarChar(80)
  /// Denormalized convenience for fast last-row reads / audit. Must agree
  /// with `sum(delta)` over the user's rows up to and including this one.
  balanceAfter  Int
  notes         String?            @db.VarChar(280)
  createdAt     DateTime           @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@unique([refType, refId, reason], map: "credit_ledger_ref_reason_uniq")
  @@map("credit_ledger")
}

/// Singleton-ish row tracking the last block number our payment watcher has
/// scanned. Keyed by chain id so we can run base-mainnet and base-sepolia
/// state side-by-side if you ever want to. The watcher updates this row
/// after every successful sweep.
model PaymentWatcherCursor {
  chainId        Int      @id
  lastScannedBlock BigInt
  updatedAt      DateTime @updatedAt

