{
  "name": "estio-platform",
  "private": true,
  "description": "Estio — public site, admin, and API monorepo",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:api": "npm run start:dev --workspace=api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "deploy:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "stack:up": "bash deploy/stack-up.sh",
    "verify:prod": "bash deploy/verify-production.sh",
    "reset:api": "bash deploy/reset-local-api.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
