# =============================================================================
# Single-node: `.env` next to docker-compose.prod.yml
# Split (VM 901 app / VM 902 DB / VM 900 worker): deploy/env.split.example
#
# Split mapping: DATABASE_URL -> VM 902 | REDIS_URL -> VM 901 | MEDIA_WORKER_URL -> VM 900
# =============================================================================

POSTGRES_PASSWORD=replace-with-strong-password

# JWT / admin (see docker-compose.prod.yml for full list)
# JWT_SECRET=
# ADMIN_PASSWORD=

# Ask Estio AI (DeepSeek) — required for live answers on /public/ai-studio/ask
# Copy this file to .env in the repo root (same folder as docker-compose.prod.yml), then:
#   docker compose -f docker-compose.prod.yml up -d api
# Never commit .env or real keys.
ASK_ESTIO_AI_ENABLED=true
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# AI Studio jobs (BullMQ) — compose sets REDIS_URL=redis://redis:6379 by default
# Split VM 901: keep REDIS_URL=redis://redis:6379 (Redis runs beside API on 901)
# REDIS_URL=
# Optional external GPU worker; if unset, jobs use built-in placeholder outputs
# WORKSTATION_URL=
# WORKSTATION_SECRET=

# GPU media worker (FastAPI → ComfyUI) on VM 900, or tunnel to this host :9000.
# Nest: POST /media/generate-image → POST {MEDIA_WORKER_URL}/generate-image
#      GET  /media/worker-health → GET  {MEDIA_WORKER_URL}/health
#
# Split LAN (VM 901 app → VM 900 worker): use the worker’s private IP/DNS, e.g.
#   MEDIA_WORKER_URL=http://10.0.0.90:9000
# Single host + SSH tunnel into Docker API: host.docker.internal (compose extra_hosts). Tunnel bind 0.0.0.0:9000.
MEDIA_WORKER_URL=http://host.docker.internal:9000
# Production: keep 660000 (~11m) so long Comfy runs are not cut off. For staging smoke tests only,
# you may temporarily lower (e.g. 60000) to fail fast when the tunnel is down — never below real max job time in prod.
MEDIA_WORKER_TIMEOUT_MS=660000
MEDIA_WORKER_HEALTH_TIMEOUT_MS=10000
# Worker transport: sync (default) = blocking /generate-image; async = workstation /jobs/* + Estio poll
# MEDIA_WORKER_MODE=sync
# MEDIA_WORKER_ASYNC_SUBMIT_PATH=/jobs/generate-image
# Optional per-mode overrides (Studio multi-mode); defaults shown:
# MEDIA_WORKER_ASYNC_SUBMIT_PATH_TEXT_TO_IMAGE=/jobs/generate-image
# MEDIA_WORKER_ASYNC_SUBMIT_PATH_IMAGE_TO_VIDEO=/jobs/image-to-video
# MEDIA_WORKER_ASYNC_SUBMIT_PATH_TEXT_TO_VIDEO=/jobs/text-to-video
# Sync video (image_to_video / text_to_video) always uses POST /generate-media (these are unused):
# MEDIA_WORKER_SYNC_PATH_IMAGE_TO_VIDEO=
# MEDIA_WORKER_SYNC_PATH_TEXT_TO_VIDEO=
# MEDIA_WORKER_ASYNC_JOB_BASE_PATH=/jobs
# MEDIA_WORKER_ASYNC_SUBMIT_TIMEOUT_MS=30000
# MEDIA_WORKER_ASYNC_POLL_REQUEST_TIMEOUT_MS=10000
# MEDIA_WORKER_ASYNC_POLL_INTERVAL_MS=500
# Optional: submit response id keys (comma-separated) and primary status field name
# MEDIA_WORKER_ASYNC_JOB_ID_KEYS=id,job_id,jobId,uuid
# MEDIA_WORKER_ASYNC_STATUS_JSON_FIELD=status
# Optional: GET /media/worker-debug — set true only while troubleshooting, then false or unset
# MEDIA_WORKER_DEBUG=false
# API on host only (no Docker): MEDIA_WORKER_URL=http://127.0.0.1:9000

# ComfyUI-style job results (only filename/subfolder in JSON): Studio needs a browser URL for `<img>`.
#
# Option A — public Comfy (or tunnel) serves /view directly:
# MEDIA_JOB_VIEW_BASE_URL=https://comfy.yourdomain
# MEDIA_JOB_VIEW_PATH=/view
# NEXT_PUBLIC_MEDIA_JOB_VIEW_BASE_URL=https://comfy.yourdomain
# NEXT_PUBLIC_MEDIA_JOB_VIEW_PATH=/view
#
# Option B — proxy through the Estio API (worker only on host.docker.internal / tunnel :9000):
# PUBLIC_FILE_BASE_URL=https://api.estio.org
# MEDIA_JOB_VIEW_BASE_URL=https://api.estio.org
# MEDIA_JOB_VIEW_PATH=/media/comfy-view
# MEDIA_JOB_VIEW_PROXY_UPSTREAM=http://host.docker.internal:9000
# MEDIA_JOB_VIEW_UPSTREAM_PATH=/view
# NEXT_PUBLIC_MEDIA_JOB_VIEW_BASE_URL=https://api.estio.org
# NEXT_PUBLIC_MEDIA_JOB_VIEW_PATH=/media/comfy-view
# Rebuild web after changing NEXT_PUBLIC_*.
# Force in-process queue (no Redis): AI_JOBS_USE_MEMORY=true
