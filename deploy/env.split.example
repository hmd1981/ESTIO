# Estio — 3-VM split production (copy to repo root as `.env` for docker-compose.prod.split.yml)
#
# VM 901 = App | VM 902 = PostgreSQL | VM 900 = GPU worker (FastAPI only)
#
# Required mapping:
#   DATABASE_URL  -> VM 902 (Postgres)
#   REDIS_URL     -> VM 901 (Redis beside API; default below)
#   MEDIA_WORKER_URL -> VM 900 (worker HTTP)

POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://estio:replace-with-strong-password@<VM902_PRIVATE_IP_OR_DNS>:5432/estio?schema=public

REDIS_URL=redis://redis:6379
MEDIA_WORKER_URL=http://<VM900_PRIVATE_IP_OR_DNS>:9000
MEDIA_WORKER_MODE=async
MEDIA_WORKER_ASYNC_SUBMIT_PATH=/jobs/generate-image
MEDIA_WORKER_ASYNC_JOB_BASE_PATH=/jobs
MEDIA_WORKER_TIMEOUT_MS=660000
MEDIA_WORKER_HEALTH_TIMEOUT_MS=10000

# ComfyUI outputs (filename only in API result): public Comfy /view base for Studio preview
# MEDIA_JOB_VIEW_BASE_URL=https://your-comfy-public-host
# NEXT_PUBLIC_MEDIA_JOB_VIEW_BASE_URL=https://your-comfy-public-host

# Optional per-mode paths (defaults match Estio media-job routing if unset in compose)
# MEDIA_WORKER_ASYNC_SUBMIT_PATH_TEXT_TO_IMAGE=/jobs/generate-image
# MEDIA_WORKER_ASYNC_SUBMIT_PATH_IMAGE_TO_VIDEO=/jobs/image-to-video
# MEDIA_WORKER_ASYNC_SUBMIT_PATH_TEXT_TO_VIDEO=/jobs/text-to-video

# --- Auth / admin ---
JWT_SECRET=replace-with-long-random-secret
ADMIN_PASSWORD=replace-with-strong-password

# --- Public URLs (browser + uploads) ---
# NEXT_PUBLIC_API_URL must be the URL browsers use to reach the API (e.g. https://api.estio.org or https://estio.org via reverse proxy).
NEXT_PUBLIC_API_URL=https://<YOUR_PUBLIC_API_HOST>
PUBLIC_FILE_BASE_URL=https://<YOUR_PUBLIC_API_HOST>
NEXT_PUBLIC_WEB_URL=https://<YOUR_PUBLIC_WEB_HOST>
WEB_REVALIDATE_URL=http://web:3000
# REVALIDATE_SECRET=
# PREVIEW_TOKEN=

# --- Ask Estio AI ---
ASK_ESTIO_AI_ENABLED=true
DEEPSEEK_API_KEY=
